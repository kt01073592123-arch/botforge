# Neon Postgres (https://neon.tech — ulanish stringi)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Platform Telegram bot (BotFather'dan oling - WebApp login uchun)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Token encryption (32 bytes hex, openssl rand -hex 32)
