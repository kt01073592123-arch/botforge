# AI Provider
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Cron secret (cron-job.org yoki Vercel Cron uchun)
CRON_SECRET=

# Click.uz (ixtiyoriy — to‘lov uchun)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
